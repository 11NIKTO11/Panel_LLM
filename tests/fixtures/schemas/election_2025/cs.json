          "voted": {
            "description": "Pravděpodobnost, že se respondent zúčastnil.",
            "maximum": 1,
            "minimum": 0,
            "title": "Voted",
            "type": "number"
          },
          "not_voted": {
            "description": "Pravděpodobnost, že se respondent nezúčastnil.",
            "maximum": 1,
            "minimum": 0,
            "title": "Not Voted",
            "type": "number"
          }
        },
        "required": [
          "voted",
          "not_voted"
        ],
        "title": "TurnoutProbability",
        "type": "object"
      }
    },
    "description": "Strukturovaný výstup: rozdělení pravděpodobnosti mezi nabízené možnosti.",
