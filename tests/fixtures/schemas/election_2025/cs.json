            "title": "Name",
            "type": "string"
          },
          "probability": {
            "description": "Pravděpodobnost této možnosti.",
            "maximum": 1,
            "minimum": 0,
            "title": "Probability",
            "type": "number"
          }
        },
        "required": [
          "name",
          "probability"
        ],
        "title": "OptionProbability",
        "type": "object"
      },
      "TurnoutProbability": {
        "description": "Pravděpodobnost, že se respondent zúčastnil, a že se nezúčastnil.",
